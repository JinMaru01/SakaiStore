# ─── Core ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sakai:sakai@localhost:5432/sakaistore
# Set to true for managed Postgres that requires TLS (Neon, Supabase, RDS)
DATABASE_SSL=false
# Public URL of the site (used for share links, OG images, Telegram links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Long random string used to sign admin sessions: `openssl rand -base64 32`
AUTH_SECRET=change-me-to-a-long-random-string
# Password for /admin
ADMIN_PASSWORD=change-me

# ─── Payments (ABA / Bakong KHQR) ───────────────────────────────────────
# mock   = fake QR + "Simulate payment" button (local testing)
# bakong = real KHQR + Bakong Open API payment check
PAYMENT_MODE=mock
# Your Bakong account id, e.g. yourname@aclb or yourname@abaa
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=Sakai Store
BAKONG_MERCHANT_CITY=Phnom Penh
# Token from https://api-bakong.nbc.gov.kh (register → renew token)
BAKONG_API_TOKEN=
BAKONG_API_BASE=https://api-bakong.nbc.gov.kh
PAYMENT_TIMEOUT_MINUTES=15

# ─── Fulfillment & player lookup ────────────────────────────────────────
# manual = admin delivers (Telegram buttons / admin panel); mock = auto-deliver
FULFILLMENT_MODE=manual
# none = skip nickname check; mock = fake nickname (for demos)
PLAYER_LOOKUP_MODE=none

# ─── Telegram bot (admin alerts + customer order updates) ────────────────
# From @BotFather. Setup guide: docs/TELEGRAM.md, then `npm run telegram:webhook`
TELEGRAM_BOT_TOKEN=
# Bot username without @
TELEGRAM_BOT_USERNAME=
# Comma-separated chat ids allowed to manage orders from Telegram.
# Numeric ids; send /id to the bot to see yours. A group id makes all its members admins.
TELEGRAM_ADMIN_CHAT_IDS=
# Generate: openssl rand -hex 32 (only A-Z a-z 0-9 _ - allowed). Required in production.
TELEGRAM_WEBHOOK_SECRET=

# ─── Cron (Vercel sends Authorization: Bearer $CRON_SECRET) ──────────────
# GET /api/cron/reconcile every 1-5 min catches payments nobody is polling.
# Generate: openssl rand -hex 32. Required in production (401 without it).
CRON_SECRET=

# ─── Social / ads tracking (optional) ───────────────────────────────────
# Meta Pixel ID = digits only; TikTok Pixel ID = capital letters + digits.
# Invalid values are ignored. NEXT_PUBLIC_* are built into the site — redeploy after changing.
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ─── Docker Compose only (docker-compose.yml; see docs/DEPLOYMENT.md) ────
# Inside the containers DATABASE_URL is built from these and points at the db service.
# POSTGRES_USER=sakai
# POSTGRES_PASSWORD=change-me-before-first-start
# POSTGRES_DB=sakaistore
# Bind the app to localhost when a reverse proxy (Caddy/nginx) serves https:
# APP_PORT=127.0.0.1:3000
